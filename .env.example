# Copy this file to .env and fill it in. Never commit .env.
#
# ── Option A: hosted OpenAI ────────────────────────────────────────────────
# OPENAI_API_KEY=sk-proj-replace-me
# OPENAI_MODEL=gpt-4o-mini
# (leave OPENAI_BASE_URL commented out)
#
# ── Option B: local model via Ollama ───────────────────────────────────────
# Requires `ollama serve` running and a model that supports tool calling.
# Check with: ollama show <model> | grep -i tools
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:4b

# Run `pnpm models` to list what the configured endpoint actually offers.
